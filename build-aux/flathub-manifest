#!/usr/bin/env python3
"""Writes the files for the Flathub repository of the app into OUT_DIR: the
manifest, building from the release tag instead of this checkout, and the
vendored crate sources it needs.

    build-aux/flathub-manifest v1.0.0 COMMIT OUT_DIR
"""

import json
import shutil
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
APP_ID = "io.github.larsw.MSGViewer"
REPOSITORY = "https://github.com/larsw/MSGViewer.git"


def main():
    if len(sys.argv) != 4:
        sys.exit("usage: flathub-manifest TAG COMMIT OUT_DIR")
    tag, commit, out = sys.argv[1], sys.argv[2], Path(sys.argv[3])

    manifest = json.loads((ROOT / "build-aux" / f"{APP_ID}.json").read_text())
    module = next(m for m in manifest["modules"] if m["name"] == "msg-viewer")
    module["sources"] = [
        {"type": "git", "url": REPOSITORY, "tag": tag, "commit": commit}
        if isinstance(source, dict) and source.get("type") == "dir"
        else source
        for source in module["sources"]
    ]

    out.mkdir(parents=True, exist_ok=True)
    (out / f"{APP_ID}.json").write_text(json.dumps(manifest, indent=2) + "\n")
    shutil.copy(ROOT / "build-aux" / "cargo-sources.json", out / "cargo-sources.json")
    print(f"wrote {out / f'{APP_ID}.json'} and {out / 'cargo-sources.json'}")


main()
