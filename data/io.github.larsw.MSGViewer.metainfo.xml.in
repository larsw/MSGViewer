<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.larsw.MSGViewer</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>Apache-2.0</project_license>

  <name>MSG Viewer</name>
  <summary>Read Outlook message files</summary>
  <description>
    <p>
      MSG Viewer opens Microsoft Outlook .msg files, such as emails saved
      from Outlook or sent to you as attachments, so you can read them
      without Outlook.
    </p>
    <ul>
      <li>Shows the subject, sender, date and recipients, then the message itself, including the images embedded in it</li>
      <li>Reads messages that Outlook stores as rich text (RTF), showing those written in rich text as plain text</li>
      <li>Blocks remote images and other remote content unless you load them for the message you’re reading</li>
      <li>Opens attachments in other apps or saves them, one by one or all at once, and warns before opening files that can run programs</li>
      <li>Opens messages attached to a message in a window of their own</li>
      <li>Finds text in a message and zooms it</li>
      <li>Shows messages in the font of your choice, keeping the fonts that formatted emails choose themselves</li>
      <li>Shows as much as it can of damaged files</li>
    </ul>
    <p>
      MSG Viewer only reads messages. It doesn’t send mail or connect to
      mail accounts.
    </p>
  </description>

  <developer id="io.github.larsw">
    <name translate="no">Lars Wilhelmsen</name>
  </developer>

  <launchable type="desktop-id">io.github.larsw.MSGViewer.desktop</launchable>
  <translation type="gettext">msg-viewer</translation>
  <provides>
    <binary>msg-viewer</binary>
    <mediatype>application/vnd.ms-outlook</mediatype>
  </provides>

  <url type="homepage">https://github.com/larsw/MSGViewer</url>
  <url type="bugtracker">https://github.com/larsw/MSGViewer/issues</url>
  <url type="vcs-browser">https://github.com/larsw/MSGViewer</url>

  <!-- Taken with build-aux/make-screenshots from made-up messages; the URLs
       point at the release tag so they never change under a release. -->
  <screenshots>
    <screenshot type="default">
      <caption>A message with its recipients, attachments and an embedded image</caption>
      <image>https://raw.githubusercontent.com/larsw/MSGViewer/v1.0.0/data/screenshots/message.png</image>
    </screenshot>
    <screenshot>
      <caption>The same message in the dark style</caption>
      <image>https://raw.githubusercontent.com/larsw/MSGViewer/v1.0.0/data/screenshots/message-dark.png</image>
    </screenshot>
    <screenshot>
      <caption>Remote content stays blocked until you load it</caption>
      <image>https://raw.githubusercontent.com/larsw/MSGViewer/v1.0.0/data/screenshots/remote-content.png</image>
    </screenshot>
  </screenshots>

  <branding>
    <color type="primary" scheme_preference="light">#99c1f1</color>
    <color type="primary" scheme_preference="dark">#1a5fb4</color>
  </branding>

  <content_rating type="oars-1.1" />

  <requires>
    <display_length compare="ge">360</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>touch</control>
  </supports>

  <releases>
    <release version="1.0.0" date="2026-10-28">
      <description>
        <p>The first release. MSG Viewer opens Outlook .msg files and shows:</p>
        <ul>
          <li>The subject, sender, date and recipients, in the message’s own character set</li>
          <li>HTML, rich-text (RTF) and plain-text message bodies, with embedded images, and remote content blocked until you load it</li>
          <li>Attachments, which open in other apps or can be saved, with a warning before opening files that can run programs</li>
          <li>Messages attached to a message, in a window of their own</li>
          <li>Meetings, contacts, tasks and notes, and a notice for signed and encrypted messages</li>
        </ul>
        <p>You can also find text in a message, zoom it, choose the font messages are shown in, and drop files onto a window to open them.</p>
      </description>
    </release>
  </releases>
</component>
