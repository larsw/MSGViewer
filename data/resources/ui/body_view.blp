using Gtk 4.0;
using Adw 1;
using WebKit 6.0;

template $MsgViewerBodyView: Box {
  orientation: vertical;

  Separator {}

  // Bars about the Body go here.
  // Shown only when the Body references Remote content.
  Adw.Banner remote_content_banner {
    title: _("Remote content is blocked to protect your privacy");
    button-label: _("_Load Remote Content");
    action-name: "body.load-remote-content";
  }

  WebKit.WebView web_view {
    vexpand: true;

    // Nothing is stored on disk, and nothing carries over between windows.
    network-session: WebKit.NetworkSession {
      is-ephemeral: true;
    };

    user-content-manager: WebKit.UserContentManager {};

    // The web view is transparent for plain-text Bodies, so this draws their
    // background.
    styles [
      "view",
    ]
  }
}
