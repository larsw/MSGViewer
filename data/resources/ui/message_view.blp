using Gtk 4.0;
using Adw 1;

translation-domain "msg-viewer";

template $MsgViewerMessageView: Box {
  orientation: vertical;

  // Says that a signed Message's signature isn't checked.
  Adw.Banner protection_banner {}

  $MsgViewerHeaderBlock header_block {}

  $MsgViewerAttachmentStrip attachment_strip {}

  // The Body fills the rest of the window and scrolls by itself, so the
  // Header block and attachment strip stay in view.
  $MsgViewerBodyView body_view {
    vexpand: true;
  }

  // Takes the place of the Attachments and Body of a signed or encrypted
  // Message whose content can't be shown.
  Adw.StatusPage protection_page {
    visible: false;
    vexpand: true;

    styles [
      "compact",
    ]
  }
}
